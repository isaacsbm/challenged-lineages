    {
      "@id": "ccv:ReasonScheme",
      "@type": "skos:ConceptScheme",
      "skos:prefLabel": {
        "@value": "Challenge reasons",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Values of ccv:challengeReason. Starter values drawn from the rationales OIF reports most often; the scheme may be extended. It now also holds the reasons given in ALA's Top 10 Most Challenged Books lists, 2001–2024: older ALA wording is kept as alternative labels, and narrower values are filed under the starter values.",
        "@language": "en"
      },
      "skos:hasTopConcept": [
        {
          "@id": "ccv:reason-claimed-obscenity-for-minors"
        },
        {
          "@id": "ccv:reason-lgbtqia-representation"
        },
