    "skos": "http://www.w3.org/2004/02/skos/core#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "vann": "http://purl.org/vocab/vann/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "@base": "https://isaacsbm.github.io/challenged-lineages/terms#"
  },
  "@graph": [
    {
      "@id": "https://isaacsbm.github.io/challenged-lineages/terms",
      "@type": "owl:Ontology",
      "dcterms:title": {
        "@value": "Challenged Collections Vocabulary",
        "@language": "en"
      },
      "dcterms:description": {
        "@value": "Terms describing formal challenges to, and other suppression of, library and educational materials, and the relationships between challenged works.",
        "@language": "en"
      },
      "dcterms:creator": "Brittany Isaacson",
      "dcterms:created": {
        "@value": "2026-10-28",
        "@type": "xsd:date"
      },
      "rdfs:comment": {
        "@value": "Created for this assignment and published with the project site, so its URIs resolve.",
        "@language": "en"
      },
      "vann:preferredNamespacePrefix": "ccv",
      "vann:preferredNamespaceUri": "https://isaacsbm.github.io/challenged-lineages/terms#"
    },
    {
      "@id": "ccv:challengeLineage",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "Challenge Lineage",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Links a challenged work to an earlier work from which it derives or to which it responds, where the later work's challenge concerns content, themes, or form carried over from the earlier work.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://isaacsbm.github.io/challenged-lineages/terms"
      },
      "skos:scopeNote": [
        {
          "@value": "Domain: A creative work that has been formally challenged or suppressed.",
          "@language": "en"
        },
        {
          "@value": "Range: A creative work.",
          "@language": "en"
        }
      ],
      "rdfs:comment": {
        "@value": "Differs from bf:derivativeOf and schema:isBasedOn by asserting a censorship relationship, not merely a creative one. The target need not itself be challenged (e.g., Beowulf for Grendel); when both are, the link records a shared history. Should be paired with ccv:influenceEvidence.",
        "@language": "en"
      },
      "dcam:domainIncludes": [
        {
          "@id": "bf:Work"
        },
        {
          "@id": "bf:Instance"
        }
      ],
      "dcam:rangeIncludes": [
        {
          "@id": "bf:Work"
        }
      ]
    },
    {
      "@id": "ccv:influenceEvidence",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "Influence Evidence",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The basis on which a link between two works is established.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://isaacsbm.github.io/challenged-lineages/terms"
      },
      "skos:scopeNote": [
        {
          "@value": "Range: One of: explicit reference; title or epigraph allusion; adaptation; retelling; parody; author-acknowledged; critical attribution; same author; genre lineage.",
          "@language": "en"
        }
      ],
      "rdfs:comment": {
        "@value": "Records how strong the evidence for a ccv:challengeLineage link is, since influence claims vary widely in reliability. Values are listed roughly from most to least verifiable.",
        "@language": "en"
      },
      "dcam:domainIncludes": [
        {
          "@id": "bf:Work"
        },
        {
          "@id": "bf:Instance"
        },
        {
          "@id": "rdf:Statement"
        }
      ],
      "dcam:rangeIncludes": [
        {
          "@id": "skos:Concept"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "ccv:EvidenceScheme"
      }
    },
    {
      "@id": "ccv:challengeReason",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "Challenge Reason",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A stated reason given in a formal request to remove or restrict a work.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://isaacsbm.github.io/challenged-lineages/terms"
      },
      "skos:scopeNote": [
        {
          "@value": "Range: A concept from a SKOS concept scheme. Starter values drawn from the rationales OIF reports most often: claimed obscenity for minors; LGBTQIA+ representation; race, racism, equity, and social justice; political or religious viewpoint; Palestinian representation; immigrant representation.",
          "@language": "en"
        }
      ],
      "rdfs:comment": {
        "@value": "Records the reason as stated by the challenger, not as a finding. OIF notes that no school or public library book has ever been found by a court to meet the legal definition of obscenity for minors.",
        "@language": "en"
      },
      "dcam:domainIncludes": [
        {
          "@id": "dcmitype:Event"
        }
      ],
      "dcam:rangeIncludes": [
        {
          "@id": "skos:Concept"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "ccv:ReasonScheme"
      }
    },
    {
      "@id": "ccv:challengeInitiator",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "Challenge Initiator",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The category of person or body that filed a formal challenge.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://isaacsbm.github.io/challenged-lineages/terms"
      },
      "skos:scopeNote": [
        {
          "@value": "Range: One of: government decision-maker; board member or administrator; pressure group; parent; library user; other.",
          "@language": "en"
        }
      ],
      "rdfs:comment": {
        "@value": "Categories follow OIF's reporting, which shows government decision-makers and pressure groups behind nearly 92% of 2025 attempts. Use foaf:Agent to identify a specific person or organization where appropriate.",
        "@language": "en"
      },
      "dcam:domainIncludes": [
        {
          "@id": "dcmitype:Event"
        }
      ],
      "dcam:rangeIncludes": [
        {
          "@id": "skos:Concept"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "ccv:InitiatorScheme"
      }
    },
    {
      "@id": "ccv:challengeVenue",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "Challenge Venue",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The setting in which a challenge or other act of suppression took place.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://isaacsbm.github.io/challenged-lineages/terms"
      },
      "skos:scopeNote": [
        {
          "@value": "Range: One of: school library; classroom curriculum; public library; academic library; government censor; court; customs or postal authority; publisher.",
          "@language": "en"
        }
      ],
      "rdfs:comment": {
        "@value": "Lets one record compare library challenges with older and non-library forms of suppression found in this collection (We, Ulysses, The Wind Done Gone, the expurgated Fahrenheit 451).",
        "@language": "en"
      },
      "dcam:domainIncludes": [
        {
          "@id": "dcmitype:Event"
        }
      ],
      "dcam:rangeIncludes": [
        {
          "@id": "skos:Concept"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "ccv:VenueScheme"
      }
    },
    {
      "@id": "ccv:challengeOutcome",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "Challenge Outcome",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The result of a formal request to remove or restrict a work.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://isaacsbm.github.io/challenged-lineages/terms"
      },
      "skos:scopeNote": [
        {
          "@value": "Range: One of: retained; restricted; relocated; removed from curriculum; banned; expurgated; enjoined; pending; none recorded.",
          "@language": "en"
        }
      ],
      "rdfs:comment": {
        "@value": "Distinguishes unsuccessful challenges from successful bans, mirroring OIF's distinction between books challenged, censored, and banned. \"None recorded\" lets a linked but unchallenged work (e.g., James) sit in the collection without implying a ban.",
        "@language": "en"
      },
      "dcam:domainIncludes": [
        {
          "@id": "dcmitype:Event"
        },
        {
          "@id": "bf:Work"
        }
      ],
      "dcam:rangeIncludes": [
        {
          "@id": "skos:Concept"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "ccv:OutcomeScheme"
      }
    },
    {
      "@id": "ccv:challengeSource",
      "@type": "rdf:Property",
      "rdfs:label": {
        "@value": "Challenge Source",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A list, rating site, or other external source from which a challenged title was drawn.",
        "@language": "en"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://isaacsbm.github.io/challenged-lineages/terms"
      },
      "skos:scopeNote": [
        {
          "@value": "Range: A web resource or named publication.",
          "@language": "en"
        }
      ],
      "rdfs:comment": {
        "@value": "Captures the multi-title, list-driven challenges OIF identifies as 94% of 2025 attempts.",
        "@language": "en"
      },
      "dcam:domainIncludes": [
        {
          "@id": "dcmitype:Event"
        }
      ]
    },
