ccv:ReasonScheme
    a skos:ConceptScheme ;
    skos:prefLabel "Challenge reasons"@en ;
    skos:definition "Values of ccv:challengeReason. Starter values drawn from the rationales OIF reports most often; the scheme may be extended. It now also holds the reasons given in ALA's Top 10 Most Challenged Books lists, 2001–2024: older ALA wording is kept as alternative labels, and narrower values are filed under the starter values."@en ;
    skos:hasTopConcept ccv:reason-claimed-obscenity-for-minors, ccv:reason-lgbtqia-representation, ccv:reason-race-racism-equity-and-social-justice, ccv:reason-political-or-religious-viewpoint, ccv:reason-palestinian-representation, ccv:reason-immigrant-representation, ccv:reason-sexually-explicit, ccv:reason-sexual-content, ccv:reason-profanity, ccv:reason-unsuited-to-age-group, ccv:reason-violence, ccv:reason-occult-satanic, ccv:reason-insensitivity, ccv:reason-nudity, ccv:reason-drugs, ccv:reason-anti-family, ccv:reason-anti-ethnic, ccv:reason-suicide, ccv:reason-gambling, ccv:reason-depiction-of-sexual-abuse, ccv:reason-depiction-of-rape, ccv:reason-incest, ccv:reason-graphic-images, ccv:reason-controversial-issues, ccv:reason-gender-bias ;
    rdfs:isDefinedBy <https://isaacsbm.github.io/challenged-lineages/terms> .

