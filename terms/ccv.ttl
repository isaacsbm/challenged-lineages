# Challenged Collections Vocabulary (ccv:). Generated from data/ccv-terms.csv and data/ccv-concepts.csv by scripts/build_data.py; edit those, not this file.
@base <https://isaacsbm.github.io/challenged-lineages/terms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcam: <http://purl.org/dc/dcam/> .
@prefix ccv: <https://isaacsbm.github.io/challenged-lineages/terms#> .
@prefix bf: <http://id.loc.gov/ontologies/bibframe/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://isaacsbm.github.io/challenged-lineages/terms>
    a owl:Ontology ;
    dcterms:title "Challenged Collections Vocabulary"@en ;
    dcterms:description "Terms describing formal challenges to, and other suppression of, library and educational materials, and the relationships between challenged works."@en ;
    dcterms:creator "Brittany Isaacson" ;
    dcterms:created "2026-10-28"^^xsd:date ;
    rdfs:comment "Created for this assignment and published with the project site, so its URIs resolve."@en ;
    vann:preferredNamespacePrefix "ccv" ;
    vann:preferredNamespaceUri "https://isaacsbm.github.io/challenged-lineages/terms#" .

ccv:challengeLineage
    a rdf:Property ;
    rdfs:label "Challenge Lineage"@en ;
    skos:definition "Links a challenged work to an earlier work from which it derives or to which it responds, where the later work's challenge concerns content, themes, or form carried over from the earlier work."@en ;
    rdfs:isDefinedBy <https://isaacsbm.github.io/challenged-lineages/terms> ;
    skos:scopeNote "Domain: A creative work that has been formally challenged or suppressed."@en, "Range: A creative work."@en ;
    rdfs:comment "Differs from bf:derivativeOf and schema:isBasedOn by asserting a censorship relationship, not merely a creative one. The target need not itself be challenged (e.g., Beowulf for Grendel); when both are, the link records a shared history. Should be paired with ccv:influenceEvidence."@en ;
    dcam:domainIncludes bf:Work, bf:Instance ;
    dcam:rangeIncludes bf:Work .

ccv:influenceEvidence
    a rdf:Property ;
    rdfs:label "Influence Evidence"@en ;
    skos:definition "The basis on which a link between two works is established."@en ;
    rdfs:isDefinedBy <https://isaacsbm.github.io/challenged-lineages/terms> ;
    skos:scopeNote "Range: One of: explicit reference; title or epigraph allusion; adaptation; retelling; parody; author-acknowledged; critical attribution; same author; genre lineage."@en ;
    rdfs:comment "Records how strong the evidence for a ccv:challengeLineage link is, since influence claims vary widely in reliability. Values are listed roughly from most to least verifiable."@en ;
    dcam:domainIncludes bf:Work, bf:Instance, rdf:Statement ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso ccv:EvidenceScheme .

ccv:challengeReason
    a rdf:Property ;
    rdfs:label "Challenge Reason"@en ;
    skos:definition "A stated reason given in a formal request to remove or restrict a work."@en ;
    rdfs:isDefinedBy <https://isaacsbm.github.io/challenged-lineages/terms> ;
    skos:scopeNote "Range: A concept from a SKOS concept scheme. Starter values drawn from the rationales OIF reports most often: claimed obscenity for minors; LGBTQIA+ representation; race, racism, equity, and social justice; political or religious viewpoint; Palestinian representation; immigrant representation."@en ;
    rdfs:comment "Records the reason as stated by the challenger, not as a finding. OIF notes that no school or public library book has ever been found by a court to meet the legal definition of obscenity for minors."@en ;
    dcam:domainIncludes dcmitype:Event ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso ccv:ReasonScheme .

ccv:challengeInitiator
    a rdf:Property ;
    rdfs:label "Challenge Initiator"@en ;
    skos:definition "The category of person or body that filed a formal challenge."@en ;
    rdfs:isDefinedBy <https://isaacsbm.github.io/challenged-lineages/terms> ;
    skos:scopeNote "Range: One of: government decision-maker; board member or administrator; pressure group; parent; library user; other."@en ;
    rdfs:comment "Categories follow OIF's reporting, which shows government decision-makers and pressure groups behind nearly 92% of 2025 attempts. Use foaf:Agent to identify a specific person or organization where appropriate."@en ;
    dcam:domainIncludes dcmitype:Event ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso ccv:InitiatorScheme .

ccv:challengeVenue
    a rdf:Property ;
    rdfs:label "Challenge Venue"@en ;
    skos:definition "The setting in which a challenge or other act of suppression took place."@en ;
    rdfs:isDefinedBy <https://isaacsbm.github.io/challenged-lineages/terms> ;
    skos:scopeNote "Range: One of: school library; classroom curriculum; public library; academic library; government censor; court; customs or postal authority; publisher."@en ;
    rdfs:comment "Lets one record compare library challenges with older and non-library forms of suppression found in this collection (We, Ulysses, The Wind Done Gone, the expurgated Fahrenheit 451)."@en ;
    dcam:domainIncludes dcmitype:Event ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso ccv:VenueScheme .

ccv:challengeOutcome
    a rdf:Property ;
    rdfs:label "Challenge Outcome"@en ;
    skos:definition "The result of a formal request to remove or restrict a work."@en ;
    rdfs:isDefinedBy <https://isaacsbm.github.io/challenged-lineages/terms> ;
    skos:scopeNote "Range: One of: retained; restricted; relocated; removed from curriculum; banned; expurgated; enjoined; pending; none recorded."@en ;
    rdfs:comment "Distinguishes unsuccessful challenges from successful bans, mirroring OIF's distinction between books challenged, censored, and banned. \"None recorded\" lets a linked but unchallenged work (e.g., James) sit in the collection without implying a ban."@en ;
    dcam:domainIncludes dcmitype:Event, bf:Work ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso ccv:OutcomeScheme .

ccv:challengeSource
    a rdf:Property ;
    rdfs:label "Challenge Source"@en ;
    skos:definition "A list, rating site, or other external source from which a challenged title was drawn."@en ;
    rdfs:isDefinedBy <https://isaacsbm.github.io/challenged-lineages/terms> ;
    skos:scopeNote "Range: A web resource or named publication."@en ;
    rdfs:comment "Captures the multi-title, list-driven challenges OIF identifies as 94% of 2025 attempts."@en ;
    dcam:domainIncludes dcmitype:Event .

ccv:EvidenceScheme
    a skos:ConceptScheme ;
    skos:prefLabel "Influence evidence types"@en ;
    skos:definition "Values of ccv:influenceEvidence, listed roughly from most to least verifiable."@en ;
    skos:hasTopConcept ccv:evidence-explicit-reference, ccv:evidence-title-or-epigraph-allusion, ccv:evidence-adaptation, ccv:evidence-retelling, ccv:evidence-parody, ccv:evidence-author-acknowledged, ccv:evidence-critical-attribution, ccv:evidence-same-author, ccv:evidence-genre-lineage ;
    rdfs:isDefinedBy <https://isaacsbm.github.io/challenged-lineages/terms> .

ccv:EvidenceSchemeOrder
    a skos:OrderedCollection ;
    skos:prefLabel "Influence evidence types, most to least verifiable"@en ;
    skos:memberList ( ccv:evidence-explicit-reference ccv:evidence-title-or-epigraph-allusion ccv:evidence-adaptation ccv:evidence-retelling ccv:evidence-parody ccv:evidence-author-acknowledged ccv:evidence-critical-attribution ccv:evidence-same-author ccv:evidence-genre-lineage ) ;
    rdfs:isDefinedBy <https://isaacsbm.github.io/challenged-lineages/terms> .

